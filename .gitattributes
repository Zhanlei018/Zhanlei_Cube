# 统一换行，避免 MinGW/git 混用导致的 diff 地狱
* text=auto

*.cpp   text diff=cpp
*.hpp   text diff=cpp
*.h     text diff=cpp
*.c     text diff=c
*.txt   text
*.md    text
*.cmake text

# 着色器必须保持 LF：有些驱动对 CRLF 的 #define 解析很敏感
*.vert  text eol=lf
*.frag  text eol=lf
*.glsl  text eol=lf

*.png   binary
*.jpg   binary
*.obj   binary
*.pptx  binary
